        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "scvmm_cluster_node_up",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "lab": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "node": "Node",
              "state": "Cluster state",
              "Value": "Status"
            },
            "indexByName": {}
          }
        }
      ],
      "description": "Membership and reachability per node. A node VMM cannot reach is DOWN here whatever the cluster service last recorded."
